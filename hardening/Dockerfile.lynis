# Modulo 2 / Encontro 3 - o MESMO ambiente da aula (ubuntu:22.04, "lab-hardening") com os
# Passos 0 a 6 aplicados, auditado pelo Lynis (Passo 7). Dois estagios:
#   encontro3 : estado ao fim da aula             -> lynis-antes.txt
#   depois    : + correcao dos 3 achados de maior severidade -> lynis-depois.txt
# Rodar tudo: bash hardening/lynis-antes-depois.sh
#
# Excecoes justificadas aos scanners de IaC (este NAO e um container de aplicacao):
#checkov:skip=CKV_DOCKER_3:o Lynis audita o SO inteiro (/etc/shadow, sudoers, sshd) e exige root; container efemero, roda e sai
#checkov:skip=CKV_DOCKER_2:container de auditoria executa um comando e encerra; nao ha servico para healthcheck
#checkov:skip=CKV2_DOCKER_1:o Passo 1 do Encontro 3 cria o usuario "aluno" com sudo; o pacote e o objeto do hardening auditado, nao e usado no build
# Trivy config: esta pasta e excluida (skip-dirs) no iac-scan.yml pelo mesmo motivo (AVD-DS-0002).

FROM ubuntu:22.04 AS encontro3
ENV DEBIAN_FRONTEND=noninteractive

# Passo 0 - pacotes basicos da aula
RUN apt-get update \
    && apt-get install -y --no-install-recommends sudo openssh-server ufw fail2ban lynis \
    && rm -rf /var/lib/apt/lists/*

# Passo 1 - usuario nao-root com sudo (o "aluno" da aula)
RUN useradd --create-home --shell /bin/bash --groups sudo aluno

# Passo 2 - bloquear o login direto do root
RUN passwd --lock root

# Passo 3 - ufw: negar entrada, permitir saida, liberar so o SSH.
# Ativar o firewall exige CAP_NET_ADMIN (nao existe num build); a politica fica gravada.
RUN sed -i 's/^DEFAULT_INPUT_POLICY=.*/DEFAULT_INPUT_POLICY="DROP"/; s/^DEFAULT_OUTPUT_POLICY=.*/DEFAULT_OUTPUT_POLICY="ACCEPT"/' /etc/default/ufw \
    && sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf \
    && printf '### tuple ### allow tcp 22 0.0.0.0/0 any 0.0.0.0/0 in\n' >> /etc/ufw/user.rules

# Passo 4 - fail2ban protegendo o SSH
COPY jail.local /etc/fail2ban/jail.local

# Passo 5 - sshd_config endurecido (material da disciplina), validado com sshd -t
COPY sshd_config.hardened /etc/ssh/sshd_config
RUN mkdir -p /run/sshd && sshd -t

# Passo 6 - permissoes: diretorio de aplicacao sem acesso para "outros"
RUN mkdir -p /srv/taskflow/config \
    && chown -R aluno:aluno /srv/taskflow \
    && chmod 750 /srv/taskflow && chmod 700 /srv/taskflow/config

# Passo 7 - auditoria
CMD ["lynis", "audit", "system", "--quick", "--no-colors"]

# ---------------------------------------------------------------------------------------
FROM encontro3 AS depois
# Correcao dos 3 achados de MAIOR severidade (os 3 "Warnings" do Lynis no estagio encontro3).
# Detalhes e justificativa: docs/lynis-achados.md

# Achado 1 - PKGS-7392 "Found one or more vulnerable packages":
#   aplica as atualizacoes de seguranca pendentes (CIS Ubuntu 1.9).
# Achado 3 (parte 1) - LOGG-2138 "klogd is not running": instala o rsyslog, que faz o papel
#   do syslogd/klogd e grava os eventos do sistema (CIS Ubuntu 4.2.1).
RUN apt-get update     && apt-get upgrade -y     && apt-get install -y --no-install-recommends rsyslog iptables     && rm -rf /var/lib/apt/lists/*

# Achado 2 - FIRE-4512 "iptables module(s) loaded, but no rules active": a politica do Passo 3
#   so existia no papel. O script ativa o ufw (regras reais no netfilter) antes da auditoria.
#   Exige CAP_NET_ADMIN, que so altera a pilha de rede DO PROPRIO container (namespace isolado).
# Achado 3 (parte 2) - o mesmo script sobe o rsyslogd antes do Lynis rodar.
COPY auditar.sh /usr/local/bin/auditar.sh
RUN chmod 755 /usr/local/bin/auditar.sh
CMD ["/usr/local/bin/auditar.sh"]
