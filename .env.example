# Modelo das variáveis do docker-compose.yml. ESTE é o único arquivo de ambiente versionado.
#   cp .env.example .env   e troque cada valor. O .env está no .gitignore.
#
# Gere valores aleatórios, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Segredo de sessão do Flask (obrigatório; a aplicação não sobe sem ele).
TASKFLOW_SECRET_KEY=troque-por-um-valor-aleatorio-longo

# Usuários de laboratório admin/aluno (1 = criar; 0 = não criar).
TASKFLOW_SEED_USERS=1

# Login do Grafana (a senha é obrigatória; não existe padrão admin/admin).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-por-uma-senha-forte
